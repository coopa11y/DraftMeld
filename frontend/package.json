{
  "name": "@draftmeld/frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "openapi-typescript ../contracts/openapi.yaml -o src/shared/api/generated.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/shared/api/generated.ts",
    "build": "tsc -b && vite build",
    "check": "npm run api:check && npm run format:check && npm run lint && tsc -b --pretty false",
    "dev": "vite",
    "format": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\" \"../package.json\" \"../scripts/**/*.{js,mjs,cjs,json}\" \"../contracts/**/*.{yaml,yml,json}\" \"../.github/**/*.{yaml,yml,json}\"",
    "format:check": "prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\" \"../package.json\" \"../scripts/**/*.{js,mjs,cjs,json}\" \"../contracts/**/*.{yaml,yml,json}\" \"../.github/**/*.{yaml,yml,json}\"",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "draftmeld": "file:..",
    "openapi-fetch": "0.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "packageManager": "npm@11.19.0"
}
